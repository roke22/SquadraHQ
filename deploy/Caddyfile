# Caddy in front of pisha-server: HTTPS for your domain, certificates from
# Let's Encrypt obtained and renewed automatically.
#
# The domain comes from PISHA_DOMAIN (see .env.example). Its DNS A/AAAA record
# must point to this machine, and ports 80 and 443 must be reachable.

{$PISHA_DOMAIN} {
	# With docker-compose.yml the server is the "pisha-server" service.
	# Running Caddy directly on the host instead? Use: reverse_proxy 127.0.0.1:7787
	reverse_proxy pisha-server:7787
}
